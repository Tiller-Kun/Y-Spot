// Turns the bundled sample data into supabase/seed.sql so the app and the
// database start from the same spots. Run with: npm run db:seed
// Uses Node's built-in TypeScript support (Node 23.6+), no build step.

import { sampleBuildings } from '../src/data/buildings.ts';
import { sampleSpots } from '../src/data/sampleSpots.ts';

const str = (value: string | null): string => (value === null ? 'null' : `'${value.replace(/'/g, "''")}'`);
const textArray = (values: string[]): string => `array[${values.map(str).join(', ')}]::text[]`;
const json = (value: unknown): string => `${str(JSON.stringify(value))}::jsonb`;

const lines: string[] = [
  '-- Generated by scripts/generate-seed.mts from src/data. Do not edit by hand.',
  '',
  'insert into public.buildings (id, name, name_ko, map_x, map_y) values',
  sampleBuildings.map((b) => `  (${str(b.id)}, ${str(b.name)}, ${str(b.nameKo)}, ${b.mapX}, ${b.mapY})`).join(',\n') + ';',
  '',
  'insert into public.spots (id, building_id, name, name_ko, category, floor, entrance_hint, directions, noise, intents, group_min, group_max, hours, amenities, access, bookable, departments, walk_minutes, tip, photo_url, busy_by_hour, verified) values',
  sampleSpots
    .map((s) =>
      [
        str(s.id),
        str(s.buildingId),
        str(s.name),
        str(s.nameKo),
        str(s.category),
        str(s.floor),
        str(s.entranceHint),
        str(s.directions),
        str(s.noise),
        textArray(s.intents),
        s.groupSize.min,
        s.groupSize.max,
        json(s.hours),
        json(s.amenities),
        str(s.access),
        s.bookable,
        textArray(s.departments),
        s.walkMinutesFromMainGate,
        str(s.tip),
        str(s.photoUrl),
        `array[${s.busyByHour.join(', ')}]::real[]`,
        s.verified,
      ].join(', '),
    )
    .map((row) => `  (${row})`)
    .join(',\n') + ';',
  '',
];

process.stdout.write(lines.join('\n'));
